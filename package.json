{
  "name": "animal-adoption-tracker",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10.1.1",
    "@sap/xssec": "^4.15.0"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "admin": {
            "password": "admin",
            "roles": [
              "Admin"
            ]
          },
          "user": {
            "password": "user",
            "roles": [
              "User"
            ]
          },
          "asha@example.com": {
            "password": "user",
            "roles": [
              "User"
            ]
          },
          "other@example.com": {
            "password": "user",
            "roles": [
              "User"
            ]
          },
          "vikram@example.com": {
            "password": "user",
            "roles": [
              "User"
            ]
          },
          "meera@example.com": {
            "password": "user",
            "roles": [
              "User"
            ]
          }
        },
        "[xsuaa]": {
          "kind": "xsuaa"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "[hybrid]": {
        "db": "hana"
      },
      "[production]": {
        "db": "hana"
      }
    }
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10.2.0",
    "cds-plugin-ui5": "^0.17.0",
    "cloudinary": "^2.11.0"
  },
  "workspaces": [
    "app/admin",
    "app/adopter"
  ],
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --open index.html",
    "watch-admin": "cds watch --open admin-app/index.html?sap-ui-xx-viewCache=false",
    "watch-adopter": "cds watch --open adopter-app/index.html?sap-ui-xx-viewCache=false",
    "test:api": "bash test/api-test.sh",
    "build:mta": "mbt build",
    "router:build": "npm run build --prefix app/router",
    "router:hybrid": "npm install --prefix app/router && npm run router:build && cds bind --exec --profile hybrid -- node app/router/start-local.js"
  },
  "sapux": [
    "app/admin",
    "app/adopter"
  ]
}

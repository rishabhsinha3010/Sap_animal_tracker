          },
          "asha@example.com": {
            "password": "user",
            "roles": [
              "User"
            ]
          },
          "other@example.com": {
            "password": "user",
            "roles": [
              "User"
            ]
          },
          "vikram@example.com": {
            "password": "user",
            "roles": [
              "User"
            ]
          },
          "meera@example.com": {
            "password": "user",
            "roles": [
              "User"
            ]
          }
        }
      },
      "[hybrid]": {
        "db": "hana"
      }
    }
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10.2.0",

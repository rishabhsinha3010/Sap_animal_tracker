{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/logged-out.html"
  },
  "routes": [
    {
      "source": "^/logged-out\\.html$",
      "target": "logged-out.html",
      "localDir": "resources",
      "authenticationType": "none",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/shared/logo\\.svg$",
      "target": "shared/logo.svg",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/admin/(.*)$",
      "target": "/admin/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Admin",
      "csrfProtection": true
    },
    {
      "source": "^/user/(.*)$",
      "target": "/user/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/admin-app/(.*)$",
      "target": "admin-app/$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Admin"
    },
    {
      "source": "^/adopter-app/(.*)$",
      "target": "adopter-app/$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.User"
    },
    {
      "source": "^/(index\\.html)?$",
      "target": "index.html",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}

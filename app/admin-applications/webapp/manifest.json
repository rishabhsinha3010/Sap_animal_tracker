{
  "_version": "1.89.0",
  "sap.app": {
    "id": "adminapplications",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "d1657736-d8a5-48bd-87e9-36d37b84a7e0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "adminapplications.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "Dashboard",
          "target": "Dashboard"
        },
        {
          "pattern": "AdoptionApplications:?query:",
          "name": "AdoptionApplicationsList",
          "target": "AdoptionApplicationsList"
        },
        {
          "pattern": "AdoptionApplications({key}):?query:",
          "name": "AdoptionApplicationsObjectPage",
          "target": "AdoptionApplicationsObjectPage"
        },
        {
          "pattern": "Animals:?query:",
          "name": "AnimalsList",
          "target": "AnimalsList"
        },
        {
          "pattern": "Animals({key}):?query:",
          "name": "AnimalsObjectPage",
          "target": "AnimalsObjectPage"
        },
        {
          "pattern": "Shelters:?query:",
          "name": "SheltersList",
          "target": "SheltersList"
        },
        {
          "pattern": "Shelters({key}):?query:",
          "name": "SheltersObjectPage",
          "target": "SheltersObjectPage"
        },
        {
          "pattern": "HealthRecords:?query:",
          "name": "HealthRecordsList",
          "target": "HealthRecordsList"
        },
        {
          "pattern": "HealthRecords({key}):?query:",
          "name": "HealthRecordsObjectPage",
          "target": "HealthRecordsObjectPage"
        },
        {
          "pattern": "Inspections:?query:",
          "name": "InspectionsList",
          "target": "InspectionsList"
        },
        {
          "pattern": "Inspections({key}):?query:",
          "name": "InspectionsObjectPage",
          "target": "InspectionsObjectPage"
        }
      ],
      "targets": {
        "Dashboard": {
          "type": "Component",
          "id": "Dashboard",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "viewName": "adminapplications.ext.dashboard.Dashboard",
              "contextPath": "/AnimalSummary"
            }
          }
        },
        "AdoptionApplicationsList": {
          "type": "Component",
          "id": "AdoptionApplicationsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/AdoptionApplications",
              "variantManagement": "Page",
              "navigation": {
                "AdoptionApplications": {
                  "detail": {
                    "route": "AdoptionApplicationsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "AdoptionApplicationsObjectPage": {
          "type": "Component",
          "id": "AdoptionApplicationsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/AdoptionApplications"
            }
          }
        },
        "AnimalsList": {
          "type": "Component",
          "id": "AnimalsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Animals",
              "variantManagement": "Page",
              "navigation": {
                "Animals": {
                  "detail": {
                    "route": "AnimalsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "AnimalsObjectPage": {
          "type": "Component",
          "id": "AnimalsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Animals"
            }
          }
        },
        "SheltersList": {
          "type": "Component",
          "id": "SheltersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Shelters",
              "variantManagement": "Page",
              "navigation": {
                "Shelters": {
                  "detail": {
                    "route": "SheltersObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "SheltersObjectPage": {
          "type": "Component",
          "id": "SheltersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Shelters"
            }
          }
        },
        "HealthRecordsList": {
          "type": "Component",
          "id": "HealthRecordsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/HealthRecords",
              "variantManagement": "Page",
              "navigation": {
                "HealthRecords": {
                  "detail": {
                    "route": "HealthRecordsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "HealthRecordsObjectPage": {
          "type": "Component",
          "id": "HealthRecordsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/HealthRecords"
            }
          }
        },
        "InspectionsList": {
          "type": "Component",
          "id": "InspectionsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Inspections",
              "variantManagement": "Page",
              "navigation": {
                "Inspections": {
                  "detail": {
                    "route": "InspectionsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "InspectionsObjectPage": {
          "type": "Component",
          "id": "InspectionsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Inspections"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
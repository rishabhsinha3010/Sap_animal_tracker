{
  "_version": "1.89.0",
  "sap.app": {
    "id": "animaladoption.adopter",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "dataSources": {
      "mainService": {
        "uri": "/user/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "animaladoption.adopter.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties",
        "settings": {
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "Home",
          "target": "Home"
        },
        {
          "pattern": "Animals:?query:",
          "name": "AnimalsList",
          "target": "AnimalsList"
        },
        {
          "pattern": "Animals({key}):?query:",
          "name": "AnimalsObjectPage",
          "target": "AnimalsObjectPage"
        },
        {
          "pattern": "AdoptionApplications:?query:",
          "name": "AdoptionApplicationsList",
          "target": "AdoptionApplicationsList"
        },
        {
          "pattern": "AdoptionApplications({key}):?query:",
          "name": "AdoptionApplicationsObjectPage",
          "target": "AdoptionApplicationsObjectPage"
        },
        {
          "pattern": "Users({key}):?query:",
          "name": "UsersObjectPage",
          "target": "UsersObjectPage"
        }
      ],
      "targets": {
        "Home": {
          "type": "Component",
          "id": "Home",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "viewName": "animaladoption.adopter.ext.home.Home",
              "contextPath": "/Animals"
            }
          }
        },
        "AnimalsList": {
          "type": "Component",
          "id": "AnimalsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Animals",
              "variantManagement": "Page",
              "navigation": {
                "Animals": {
                  "detail": {
                    "route": "AnimalsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "growingThreshold": 20
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "AnimalsObjectPage": {
          "type": "Component",
          "id": "AnimalsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Animals"
            }
          }
        },
        "AdoptionApplicationsList": {
          "type": "Component",
          "id": "AdoptionApplicationsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/AdoptionApplications",
              "variantManagement": "Page",
              "navigation": {
                "AdoptionApplications": {
                  "detail": {
                    "route": "AdoptionApplicationsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "growingThreshold": 20
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "AdoptionApplicationsObjectPage": {
          "type": "Component",
          "id": "AdoptionApplicationsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/AdoptionApplications"
            }
          }
        },
        "UsersObjectPage": {
          "type": "Component",
          "id": "UsersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Users",
              "enhanceI18n": "i18n/profile.properties"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}

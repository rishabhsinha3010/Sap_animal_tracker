<!-- Start page of the adopter app: welcome banner, my applications at a glance, and the animals
     that are available right now. The controller fills the "home" JSON model from the /user service. -->
<mvc:View controllerName="animaladoption.adopter.ext.home.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:grid="sap.ui.layout.cssgrid"
    xmlns:core="sap.ui.core">
    <Page showHeader="false" class="aaHome">
        <content>
            <VBox busy="{home>/busy}" busyIndicatorDelay="0">
                <!-- welcome banner: text and actions on the left, decorative paws on the right (css/style.css) -->
                <VBox class="aaHeroWrap">
                    <HBox class="aaHero" alignItems="Center" justifyContent="SpaceBetween">
                        <VBox class="aaHeroContent">
                            <Text text="{i18n>heroEyebrow}" class="aaHeroEyebrow"/>
                            <Title text="{home>/greeting}" level="H1" wrapping="true" class="aaHeroTitle"/>
                            <Text text="{i18n>heroText}" class="aaHeroText"/>
                            <HBox wrap="Wrap" alignItems="Center" class="aaHeroActions">
                                <Button text="{i18n>browseAnimals}" icon="sap-icon://search" press=".onBrowse" class="aaHeroPrimary"/>
                                <Button text="{i18n>myApplications}" icon="sap-icon://document-text" press=".onApplications" visible="{home>/isAdopter}" class="aaHeroGhost"/>
                                <Button text="{= ${home>/hasProfile} ? ${i18n>myProfile} : ${i18n>register} }" icon="sap-icon://person-placeholder" visible="{home>/isAdopter}"
                                    press=".onProfile" class="aaHeroGhost"/>
                            </HBox>
                        </VBox>
                        <!-- how many animals are waiting right now -->
                        <VBox class="aaHeroStat" alignItems="Center" visible="{= ${home>/availableCount} > 0 }">
                            <Text text="{home>/availableCount}" class="aaHeroStatValue"/>
                            <Text text="{i18n>heroStatLabel}" class="aaHeroStatLabel" textAlign="Center"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox class="aaSection">
                    <!-- shown until the adopter has a profile: applying needs one -->
                    <!-- logged in without the User role (e.g. as admin): can look, but cannot register or apply -->
                    <MessageStrip visible="{= !${home>/busy} &amp;&amp; !${home>/isAdopter} }" text="{i18n>notAdopterHint}"
                        type="Warning" showIcon="true" class="sapUiSmallMarginBottom"/>
                    <MessageStrip visible="{= !${home>/busy} &amp;&amp; ${home>/isAdopter} &amp;&amp; !${home>/hasProfile} }" text="{i18n>registerHint}"
                        type="Information" showIcon="true" class="sapUiSmallMarginBottom">
                        <link>
                            <Link text="{i18n>registerNow}" press=".onProfile"/>
                        </link>
                    </MessageStrip>

                    <!-- my applications at a glance -->
                    <f:Card visible="{= ${home>/applications}.length > 0 }" class="sapUiMediumMarginBottom">
                        <f:header>
                            <card:Header title="{i18n>myApplications}" subtitle="{i18n>myApplicationsSubtitle}"
                                iconSrc="sap-icon://document-text" press=".onApplications"/>
                        </f:header>
                        <f:content>
                            <List items="{home>/applications}" class="sapUiTinyMarginBottom">
                                <StandardListItem title="{home>animalName}" description="{home>applicationID} · {i18n>appliedOn} {home>applicationDate}"
                                    info="{home>status}" infoState="{home>state}" icon="{home>photo}" iconDensityAware="false"
                                    type="Navigation" press=".onOpenApplication"/>
                            </List>
                        </f:content>
                    </f:Card>

                    <!-- available animals -->
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                        <Title text="{i18n>availableNow}" level="H2"/>
                        <Link text="{i18n>seeAll}" press=".onBrowse"/>
                    </HBox>
                    <grid:CSSGrid items="{home>/animals}" gridTemplateColumns="repeat(auto-fill, minmax(14rem, 1fr))" gridGap="1rem">
                        <grid:items>
                            <f:Card class="aaPetCard">
                                <f:content>
                                    <VBox width="100%">
                                        <Image src="{home>photo}" alt="{home>name}" densityAware="false" width="100%" height="12rem"
                                            mode="Background" backgroundSize="cover" backgroundPosition="center" class="aaPetPhoto"
                                            press=".onOpenAnimal"/>
                                        <VBox class="aaPetBody">
                                            <HBox justifyContent="SpaceBetween" alignItems="Center">
                                                <Title text="{home>name}" level="H3"/>
                                                <ObjectStatus text="{home>fee}" state="Information" inverted="true"/>
                                            </HBox>
                                            <Text text="{home>breed} · {home>gender} · {home>ageText}" class="aaMuted"/>
                                            <HBox alignItems="Center" class="sapUiTinyMarginTop">
                                                <core:Icon src="sap-icon://map" class="aaMuted sapUiTinyMarginEnd"/>
                                                <Text text="{home>shelter}" class="aaMuted"/>
                                            </HBox>
                                            <Button text="{i18n>meet} {home>name}" width="100%" press=".onOpenAnimal" class="sapUiSmallMarginTop"/>
                                        </VBox>
                                    </VBox>
                                </f:content>
                            </f:Card>
                        </grid:items>
                    </grid:CSSGrid>
                    <IllustratedMessage visible="{= !${home>/busy} &amp;&amp; ${home>/animals}.length === 0 }"
                        illustrationType="sapIllus-NoSearchResults" title="{i18n>noAnimalsTitle}" description="{i18n>noAnimalsText}"/>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>

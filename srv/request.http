// With the REST Client extension, a Send Request link appears above each ### block.
// To get ### use REST clinet extenssion.
// YWRtaW46YWRtaW4= is just admin:admin encoded.
###
GET http://localhost:4004/admin/Animals
Authorization: Basic YWRtaW46YWRtaW4=

// request rejected because we are sending in admin route for the user
###
GET http://localhost:4004/admin/Animals
Authorization: Basic dXNlcjp1c2Vy

### Admin reads adoptions (works, empty list)
GET http://localhost:4004/admin/Adoptions
Authorization: Basic YWRtaW46YWRtaW4=

### Admin tries to create an adoption (should be rejected)
POST http://localhost:4004/admin/Adoptions
Authorization: Basic YWRtaW46YWRtaW4=
Content-Type: application/json

{ "remarks": "manual attempt" }

### User reads animals (works)
GET http://localhost:4004/user/Animals
Authorization: Basic dXNlcjp1c2Vy

### User filters animals by species
GET http://localhost:4004/user/Animals?$filter=species eq 'Dog'
Authorization: Basic dXNlcjp1c2Vy

### User tries to change an animal (should be rejected)
PATCH http://localhost:4004/user/Animals(aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa)
Authorization: Basic dXNlcjp1c2Vy
Content-Type: application/json

{ "name": "Hacked" }

### Admin tries the user service (expect 403, wrong role)
GET http://localhost:4004/user/Animals
Authorization: Basic YWRtaW46YWRtaW4=

### Asha sees her 2 applications
GET http://localhost:4004/user/AdoptionApplications
Authorization: Basic asha@example.com user

### Asha sees her profile only
GET http://localhost:4004/user/Users
Authorization: Basic asha@example.com user

### Other user sees nothing (empty list)
GET http://localhost:4004/user/AdoptionApplications
Authorization: Basic other@example.com user

-----------------------------------------------------------------------------

###
GET http://localhost:4004/user/Users

### 1. Register: other@example.com has a login but no profile yet
POST http://localhost:4004/user/Users
Authorization: Basic other@example.com user
Content-Type: application/json

{ "firstName": "Priya", "lastName": "Nair", "phoneNumber": "9876543210", "city": "Chennai" }

### 2. Register again (expect 409)
POST http://localhost:4004/user/Users
Authorization: Basic other@example.com user
Content-Type: application/json

{ "firstName": "Priya", "lastName": "Nair" }

### 3. Read my profile
GET http://localhost:4004/user/Users
Authorization: Basic other@example.com user

### 4. Bad phone number (expect a validation error, if you added the optional rule)
PATCH http://localhost:4004/user/Users(<ID from step 3>)
Authorization: Basic other@example.com user
Content-Type: application/json

{ "phoneNumber": "abc" }

### 5. Deactivate my profile
DELETE http://localhost:4004/user/Users(ba0b09e0-b301-4cb7-8f59-bd21ba058357)
Authorization: Basic other@example.com user

### 6. Try to apply now (expect 403, account not active)
POST http://localhost:4004/user/AdoptionApplications
Authorization: Basic other@example.com user
Content-Type: application/json

{ "animal_ID": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb", "reasonForAdoption": "test" }

### 7. Admin can see the row, now Inactive
GET http://localhost:4004/admin/Users
Authorization: Basic YWRtaW46YWRtaW4=

### A. Start review of application 1
POST http://localhost:4004/admin/AdoptionApplications(d1d1d1d1-d1d1-d1d1-d1d1-d1d1d1d1d1d1)/AdminService.startReview
Authorization: Basic YWRtaW46YWRtaW4=
Content-Type: application/json

{}

### B. Approve it
POST http://localhost:4004/admin/AdoptionApplications(d1d1d1d1-d1d1-d1d1-d1d1-d1d1d1d1d1d1)/AdminService.approve
Authorization: Basic YWRtaW46YWRtaW4=
Content-Type: application/json

{ "remarks": "Home check passed" }

###
GET http://localhost:4004/admin/ApplicationHistory
Authorization: Basic YWRtaW46YWRtaW4=